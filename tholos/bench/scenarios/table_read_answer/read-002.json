        {"sku": "A101", "item": "sugar 10kg", "qty": 0, "reorder": "yes"},
        {"sku": "A102", "item": "olive oil 5L", "qty": 3, "reorder": "yes"},
        {"sku": "A103", "item": "dried basil", "qty": 0, "reorder": "yes"},
