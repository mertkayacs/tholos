{
  "id": "approval-002",
  "category": "approval",
  "template": "b-approval-ok",
  "agent": "Clerk",
  "workspace": {
    "agents": [
      {"name": "Clerk", "role": "You add rows to tables, but adding needs the owner's approval.", "tools": ["table_add", "finish"], "max_steps": 4}
    ],
    "tables": [
      {"name": "members", "columns": ["name", "plan"], "rows": [
        {"name": "Iris Nolan", "plan": "free"}
      ]}
    ],
    "rules": [
      {"agent": "*", "tool": "table_add", "match": "*", "decision": "ask"}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Add a member", "details": "Add member 'Theo Marsh' on the pro plan to the members table."},
  "respond": {"approve": true},
  "reference": [
    {"tool": "table_add", "args": {"table": "members", "rows": [{"name": "Theo Marsh", "plan": "pro"}]}},
    {"tool": "finish", "args": {"summary": "Added Theo Marsh."}}
  ],
  "expect": [
    {"type": "approval", "tool": "table_add"},
    {"type": "row", "table": "members", "where": {"name": "Theo Marsh"}, "has": {"plan": "pro"}},
    {"type": "finished"}
  ],
  "max_steps": 4,
  "about": "Adds a member after the owner approves the table_add."
}
