{
  "id": "update-008",
  "category": "table_update",
  "template": "b-update-field",
  "agent": "Pricer",
  "workspace": {
    "agents": [
      {"name": "Pricer", "role": "You adjust prices by reading first and updating only the product asked for.", "tools": ["table_read", "table_update", "finish"], "max_steps": 4}
    ],
    "tables": [
      {"name": "products", "columns": ["name", "price", "unit"], "rows": [
        {"name": "oat milk 1L", "price": 3.5, "unit": "each"},
        {"name": "sourdough loaf", "price": 6.0, "unit": "each"},
        {"name": "fair trade coffee 250g", "price": 12.0, "unit": "each"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Raise coffee price", "details": "The fair trade coffee now costs 13.5. Update only that product."},
  "reference": [
    {"tool": "table_read", "args": {"table": "products", "query": "name:coffee", "limit": null}},
    {"tool": "table_update", "args": {"table": "products", "row": 3, "values": {"name": null, "price": 13.5, "unit": null}}},
    {"tool": "finish", "args": {"summary": "Raised the coffee price to 13.5."}}
  ],
  "expect": [
    {"type": "row", "table": "products", "where": {"name": "fair trade coffee 250g"}, "has": {"price": 13.5}},
    {"type": "row", "table": "products", "where": {"name": "oat milk 1L"}, "has": {"price": 3.5}},
    {"type": "row", "table": "products", "where": {"name": "sourdough loaf"}, "has": {"price": 6.0}}
  ],
  "max_steps": 4,
  "about": "Updates one product's price and leaves the other prices unchanged."
}
