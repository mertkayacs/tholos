{
  "id": "update-012",
  "category": "table_update",
  "template": "b-update-condition",
  "agent": "Warden",
  "workspace": {
    "agents": [
      {"name": "Warden", "role": "You update event RSVPs by reading first and changing only the matching rows.", "tools": ["table_read", "table_update", "finish"], "max_steps": 5}
    ],
    "tables": [
      {"name": "rsvp", "columns": ["guest", "attending", "plus_one"], "rows": [
        {"guest": "Ada L", "attending": "yes", "plus_one": "no"},
        {"guest": "Bo X", "attending": "yes", "plus_one": "yes"},
        {"guest": "Cora J", "attending": "no", "plus_one": "no"},
        {"guest": "Dax W", "attending": "yes", "plus_one": "yes"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Confirm plus ones", "details": "For every guest attending with a plus one, set plus_one to confirmed. Leave the rest alone."},
  "reference": [
    {"tool": "table_read", "args": {"table": "rsvp", "query": "attending:yes plus_one:yes", "limit": null}},
    {"tool": "table_update", "args": {"table": "rsvp", "row": 2, "values": {"guest": null, "attending": null, "plus_one": "confirmed"}}},
    {"tool": "table_update", "args": {"table": "rsvp", "row": 4, "values": {"guest": null, "attending": null, "plus_one": "confirmed"}}},
    {"tool": "finish", "args": {"summary": "Confirmed the plus ones."}}
  ],
  "expect": [
    {"type": "row", "table": "rsvp", "where": {"guest": "Bo X"}, "has": {"plus_one": "confirmed"}},
    {"type": "row", "table": "rsvp", "where": {"guest": "Dax W"}, "has": {"plus_one": "confirmed"}},
    {"type": "row", "table": "rsvp", "where": {"guest": "Ada L"}, "has": {"plus_one": "no"}},
    {"type": "row", "table": "rsvp", "where": {"guest": "Cora J"}, "has": {"plus_one": "no"}}
  ],
  "max_steps": 5,
  "about": "Updates only attending guests with a plus one and leaves others."
}
