{
  "id": "update-010",
  "category": "table_update",
  "template": "b-update-condition",
  "agent": "Mover",
  "workspace": {
    "agents": [
      {"name": "Mover", "role": "You update shipment statuses by reading first and changing only the matching rows.", "tools": ["table_read", "table_update", "finish"], "max_steps": 5}
    ],
    "tables": [
      {"name": "shipments", "columns": ["tracking", "carrier", "status"], "rows": [
        {"tracking": "TRK-001", "carrier": "dhl", "status": "in transit"},
        {"tracking": "TRK-002", "carrier": "fedex", "status": "pending"},
        {"tracking": "TRK-003", "carrier": "dhl", "status": "in transit"},
        {"tracking": "TRK-004", "carrier": "ups", "status": "delivered"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Deliver dhl shipments", "details": "Mark every dhl shipment as delivered. Leave the other carriers alone."},
  "reference": [
    {"tool": "table_read", "args": {"table": "shipments", "query": "carrier:dhl", "limit": null}},
    {"tool": "table_update", "args": {"table": "shipments", "row": 1, "values": {"tracking": null, "carrier": null, "status": "delivered"}}},
    {"tool": "table_update", "args": {"table": "shipments", "row": 3, "values": {"tracking": null, "carrier": null, "status": "delivered"}}},
    {"tool": "finish", "args": {"summary": "Marked the dhl shipments as delivered."}}
  ],
  "expect": [
    {"type": "row", "table": "shipments", "where": {"tracking": "TRK-001"}, "has": {"status": "delivered"}},
    {"type": "row", "table": "shipments", "where": {"tracking": "TRK-003"}, "has": {"status": "delivered"}},
    {"type": "row", "table": "shipments", "where": {"tracking": "TRK-002"}, "has": {"status": "pending"}},
    {"type": "row", "table": "shipments", "where": {"tracking": "TRK-004"}, "has": {"status": "delivered"}}
  ],
  "max_steps": 5,
  "about": "Updates only shipments from one carrier and leaves the rest."
}
