{
  "id": "update-011",
  "category": "table_update",
  "template": "b-update-condition",
  "agent": "Keeper",
  "workspace": {
    "agents": [
      {"name": "Keeper", "role": "You update task assignments by reading first and changing only the matching rows.", "tools": ["table_read", "table_update", "finish"], "max_steps": 5}
    ],
    "tables": [
      {"name": "tasks", "columns": ["title", "assignee", "status"], "rows": [
        {"title": "fix login", "assignee": "Sara", "status": "todo"},
        {"title": "update docs", "assignee": "Tom", "status": "todo"},
        {"title": "ship v1.2", "assignee": "Sara", "status": "doing"},
        {"title": "write changelog", "assignee": "Lee", "status": "todo"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Reassign Sara's todos", "details": "Reassign every todo task owned by Sara to Lee. Leave doing tasks and other assignees alone."},
  "reference": [
    {"tool": "table_read", "args": {"table": "tasks", "query": "assignee:Sara status:todo", "limit": null}},
    {"tool": "table_update", "args": {"table": "tasks", "row": 1, "values": {"title": null, "assignee": "Lee", "status": null}}},
    {"tool": "finish", "args": {"summary": "Reassigned Sara's todo tasks to Lee."}}
  ],
  "expect": [
    {"type": "row", "table": "tasks", "where": {"title": "fix login"}, "has": {"assignee": "Lee"}},
    {"type": "row", "table": "tasks", "where": {"title": "ship v1.2"}, "has": {"assignee": "Sara"}},
    {"type": "row", "table": "tasks", "where": {"title": "update docs"}, "has": {"assignee": "Tom"}},
    {"type": "row", "table": "tasks", "where": {"title": "write changelog"}, "has": {"assignee": "Lee"}}
  ],
  "max_steps": 5,
  "about": "Reassigns only the todo tasks of one person and leaves doing tasks alone."
}
