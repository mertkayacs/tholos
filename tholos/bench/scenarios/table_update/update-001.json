{
  "id": "update-001",
  "category": "table_update",
  "template": "b-update-status",
  "agent": "Mover",
  "workspace": {
    "agents": [
      {"name": "Mover", "role": "You update rows in workspace tables by reading first, then changing only the right ones.", "tools": ["table_read", "table_update", "finish"], "max_steps": 5}
    ],
    "tables": [
      {"name": "leads", "columns": ["title", "status", "owner"], "rows": [
        {"title": "Willowfield supply", "status": "new", "owner": "Sara"},
        {"title": "Harbor logistics", "status": "new", "owner": "Tom"},
        {"title": "Maple bakery", "status": "contacted", "owner": "Sara"},
        {"title": "Cedar roofing", "status": "new", "owner": "Lee"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Mark contacted", "details": "Mark every lead owned by Sara as contacted. Leave the other owners alone."},
  "reference": [
    {"tool": "table_read", "args": {"table": "leads", "query": "owner:Sara", "limit": null}},
    {"tool": "table_update", "args": {"table": "leads", "row": 1, "values": {"title": null, "status": "contacted", "owner": null}}},
    {"tool": "table_update", "args": {"table": "leads", "row": 3, "values": {"title": null, "status": "contacted", "owner": null}}},
    {"tool": "finish", "args": {"summary": "Marked Sara's leads as contacted."}}
  ],
  "expect": [
    {"type": "row", "table": "leads", "where": {"title": "Willowfield supply"}, "has": {"status": "contacted"}},
    {"type": "row", "table": "leads", "where": {"title": "Maple bakery"}, "has": {"status": "contacted"}},
    {"type": "row", "table": "leads", "where": {"title": "Harbor logistics"}, "has": {"status": "new"}},
    {"type": "row", "table": "leads", "where": {"title": "Cedar roofing"}, "has": {"status": "new"}}
  ],
  "max_steps": 5,
  "about": "Updates only the rows owned by one person and leaves others unchanged."
}
