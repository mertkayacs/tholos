{
  "id": "update-014",
  "category": "table_update",
  "template": "b-update-field2",
  "agent": "Loader",
  "workspace": {
    "agents": [
      {"name": "Loader", "role": "You update vehicle records by reading first and changing only the row asked for.", "tools": ["table_read", "table_update", "finish"], "max_steps": 4}
    ],
    "tables": [
      {"name": "vehicles", "columns": ["plate", "driver", "status"], "rows": [
        {"plate": "ABC-123", "driver": "Nadia", "status": "active"},
        {"plate": "DEF-456", "driver": "Rui", "status": "active"},
        {"plate": "GHI-789", "driver": "Lena", "status": "service"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Vehicle to service", "details": "Take vehicle DEF-456 out of service for maintenance. Update only that row."},
  "reference": [
    {"tool": "table_read", "args": {"table": "vehicles", "query": "plate:DEF-456", "limit": null}},
    {"tool": "table_update", "args": {"table": "vehicles", "row": 2, "values": {"plate": null, "driver": null, "status": "service"}}},
    {"tool": "finish", "args": {"summary": "Moved DEF-456 to service."}}
  ],
  "expect": [
    {"type": "row", "table": "vehicles", "where": {"plate": "DEF-456"}, "has": {"status": "service"}},
    {"type": "row", "table": "vehicles", "where": {"plate": "ABC-123"}, "has": {"status": "active"}},
    {"type": "row", "table": "vehicles", "where": {"plate": "GHI-789"}, "has": {"status": "service"}}
  ],
  "max_steps": 4,
  "about": "Updates one vehicle's status and leaves the other vehicles unchanged."
}
