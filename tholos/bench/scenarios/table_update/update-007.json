{
  "id": "update-007",
  "category": "table_update",
  "template": "b-update-field",
  "agent": "Editor",
  "workspace": {
    "agents": [
      {"name": "Editor", "role": "You correct fields in workspace tables by reading first and updating only the row asked for.", "tools": ["table_read", "table_update", "finish"], "max_steps": 4}
    ],
    "tables": [
      {"name": "contacts", "columns": ["name", "phone", "city"], "rows": [
        {"name": "Omar Haddad", "phone": "555-0101", "city": "Beirut"},
        {"name": "Ingrid Larsen", "phone": "555-0102", "city": "Oslo"},
        {"name": "Tomas Reza", "phone": "555-0103", "city": "Lisbon"}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Fix Ingrid's phone", "details": "Ingrid Larsen changed her phone number to 555-0137. Update her row only."},
  "reference": [
    {"tool": "table_read", "args": {"table": "contacts", "query": "name:Ingrid", "limit": null}},
    {"tool": "table_update", "args": {"table": "contacts", "row": 2, "values": {"name": null, "phone": "555-0137", "city": null}}},
    {"tool": "finish", "args": {"summary": "Updated Ingrid's phone number."}}
  ],
  "expect": [
    {"type": "row", "table": "contacts", "where": {"name": "Ingrid Larsen"}, "has": {"phone": "555-0137"}},
    {"type": "row", "table": "contacts", "where": {"name": "Omar Haddad"}, "has": {"phone": "555-0101"}},
    {"type": "row", "table": "contacts", "where": {"name": "Tomas Reza"}, "has": {"phone": "555-0103"}}
  ],
  "max_steps": 4,
  "about": "Updates a single row's phone field and leaves other rows unchanged."
}
