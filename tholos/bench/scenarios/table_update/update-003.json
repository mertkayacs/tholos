{
  "id": "update-003",
  "category": "table_update",
  "template": "b-update-status",
  "agent": "Keeper",
  "workspace": {
    "agents": [
      {"name": "Keeper", "role": "You adjust inventory quantities by reading first and updating only matching rows.", "tools": ["table_read", "table_update", "finish"], "max_steps": 5}
    ],
    "tables": [
      {"name": "stock", "columns": ["sku", "item", "qty"], "rows": [
        {"sku": "A100", "item": "flour 25kg", "qty": 14},
        {"sku": "A101", "item": "sugar 10kg", "qty": 0},
        {"sku": "A102", "item": "olive oil 5L", "qty": 3},
        {"sku": "A103", "item": "dried basil", "qty": 0},
        {"sku": "A104", "item": "cocoa powder", "qty": 22}
      ]}
    ]
  },
  "trigger": {"kind": "task", "from": "you", "title": "Restock zero items", "details": "Set every item with quantity zero to quantity 20."},
  "reference": [
    {"tool": "table_read", "args": {"table": "stock", "query": "qty:0", "limit": null}},
    {"tool": "table_update", "args": {"table": "stock", "row": 2, "values": {"sku": null, "item": null, "qty": 20}}},
    {"tool": "table_update", "args": {"table": "stock", "row": 4, "values": {"sku": null, "item": null, "qty": 20}}},
    {"tool": "finish", "args": {"summary": "Restocked the zero items to 20."}}
  ],
  "expect": [
    {"type": "row", "table": "stock", "where": {"sku": "A101"}, "has": {"qty": 20}},
    {"type": "row", "table": "stock", "where": {"sku": "A103"}, "has": {"qty": 20}},
    {"type": "row", "table": "stock", "where": {"sku": "A100"}, "has": {"qty": 14}},
    {"type": "row", "table": "stock", "where": {"sku": "A104"}, "has": {"qty": 22}}
  ],
  "max_steps": 5,
  "about": "Updates only zero-quantity items to a new quantity and leaves others."
}
