  "trigger": {"kind": "task", "from": "you", "title": "New October events", "details": "Use https://artsledger.test/october to add the missing events. Match duplicates by event title."},
  "fixtures": {"https://artsledger.test/october": "<html><head><title>October arts listings</title></head><body><h1>October</h1><p>Woodcut evening | 2026-10-02 | Print Loft</p><p>Clay whistle workshop | 2026-10-08 | South Studio</p><p>Lantern walk | 2026-10-17 | Canal Steps</p></body></html>"},
  "reference": [{"tool": "table_read", "args": {"table": "arts_events", "query": null, "limit": null}}, {"tool": "web_fetch", "args": {"url": "https://artsledger.test/october"}}, {"tool": "table_add", "args": {"table": "arts_events", "rows": [{"title": "Clay whistle workshop", "date": "2026-10-08", "venue": "South Studio"}, {"title": "Lantern walk", "date": "2026-10-17", "venue": "Canal Steps"}]}}, {"tool": "finish", "args": {"summary": "Added the clay whistle workshop and lantern walk."}}],
  "expect": [{"type": "rows", "table": "arts_events", "count": 3}, {"type": "row", "table": "arts_events", "where": {"title": "Clay whistle workshop"}, "has": {"date": "2026-10-08", "venue": "South Studio"}}, {"type": "row", "table": "arts_events", "where": {"title": "Lantern walk"}, "has": {"venue": "Canal Steps"}}, {"type": "finished"}],
