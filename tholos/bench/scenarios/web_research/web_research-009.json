{
  "id": "web_research-009", "category": "web_research", "template": "b-web-two-sources", "agent": "Esmond",
  "workspace": {"agents": [{"name": "Esmond", "role": "You compare supplier quotes without mixing units.", "tools": ["web_fetch", "table_add", "finish"], "max_steps": 6}], "tables": [{"name": "paint_quotes", "columns": ["supplier", "litres", "price", "source"], "rows": []}], "rules": [{"agent": "*", "tool": "web_fetch", "match": "*.test", "decision": "allow"}]},
  "trigger": {"kind": "task", "from": "you", "title": "Two paint quotes", "details": "Read https://ochrehut.test/paint and https://pigmentyard.test/wall-paint. Log each supplier's tin size, price, and source URL in paint_quotes."},
  "fixtures": {"https://ochrehut.test/paint": "<html><head><title>Ochre Hut paint</title></head><body><h1>Matte wall paint</h1><p>Ochre Hut: 2.5 litre tin for 19.95.</p></body></html>", "https://pigmentyard.test/wall-paint": "<html><head><title>Pigment Yard wall paint</title></head><body><h1>Interior matte</h1><p>Pigment Yard: 5 litre tin for 34.50.</p></body></html>"},
  "reference": [{"tool": "web_fetch", "args": {"url": "https://ochrehut.test/paint"}}, {"tool": "web_fetch", "args": {"url": "https://pigmentyard.test/wall-paint"}}, {"tool": "table_add", "args": {"table": "paint_quotes", "rows": [{"supplier": "Ochre Hut", "litres": 2.5, "price": 19.95, "source": "https://ochrehut.test/paint"}, {"supplier": "Pigment Yard", "litres": 5, "price": 34.5, "source": "https://pigmentyard.test/wall-paint"}]}}, {"tool": "finish", "args": {"summary": "Recorded the two quotes with their different tin sizes and source URLs."}}],
  "expect": [{"type": "rows", "table": "paint_quotes", "count": 2}, {"type": "row", "table": "paint_quotes", "where": {"supplier": "Ochre Hut"}, "has": {"litres": 2.5, "price": 19.95, "source": "https://ochrehut.test/paint"}}, {"type": "row", "table": "paint_quotes", "where": {"supplier": "Pigment Yard"}, "has": {"litres": 5, "price": 34.5}}, {"type": "finished"}],
  "max_steps": 6, "about": "Collects two supplier quotes while preserving units and provenance."
}
